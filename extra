    # Normalize depth map to 0-1 for display
    depth_norm = cv2.normalize(depth, None, 0, 1, cv2.NORM_MINMAX)

    # --- Sample depth at each detected bounding box ---
    for box in results.boxes:
        x1, y1, x2, y2 = map(int, box.xyxy[0])
        cls = results.names[int(box.cls[0])]

        # Take median depth in center region of bounding box
        cx1, cy1 = (x1 + x2) // 2 - 10, (y1 + y2) // 2 - 10
        cx2, cy2 = (x1 + x2) // 2 + 10, (y1 + y2) // 2 + 10
        roi = depth_norm[cy1:cy2, cx1:cx2]
        relative_depth = float(np.median(roi)) if roi.size > 0 else 0

        # MiDaS gives INVERSE depth — higher value = closer
        # Convert to a rough scale (tune K for your scene)
        K = 5.0
        estimated_dist = K / (relative_depth + 1e-6)

