"""
G21Z30S Distance Estimator
─────────────────────────────────────────────────────────────────────────────
Features:
  • Depth Anything V2  —  much more accurate than MiDaS
  • VISCA zoom         —  K auto-scales with camera zoom level
  • Click to measure   —  left-click anywhere on frame for instant distance
  • YOLOv8 detection   —  per-object distance labels
  • Press C            —  calibrate K with object at known distance
  • Press Q            —  quit
─────────────────────────────────────────────────────────────────────────────
"""

import cv2
import torch
import numpy as np
import serial
import serial.tools.list_ports
import time
import sys
import os

from ultralytics import YOLO
from depth_anything_v2.dpt import DepthAnythingV2

# ─────────────────────────────────────────────────────────────────────────────
# CONFIG  —  edit these
# ─────────────────────────────────────────────────────────────────────────────
CAMERA_INDEX      = 0          # capture card index (try 0,1,2 if black screen)
CAMERA_W, CAMERA_H = 1920, 1080
YOLO_MODEL        = "yolov8n.pt"
DA_ENCODER        = "vitb"     # "vits"=fast, "vitb"=balanced, "vitl"=accurate
DA_CHECKPOINT     = "checkpoints/depth_anything_v2_vitb.pth"
CALIB_DIST_M      = 2.0        # metres — distance to object when pressing C
VISCA_PORT        = None       # e.g. "COM3" or "/dev/ttyUSB0"  (None = auto-detect)
VISCA_BAUD        = 9600
MAX_ZOOM          = 30         # G21Z30S optical zoom range

# ─────────────────────────────────────────────────────────────────────────────
# VISCA ZOOM READER
# ─────────────────────────────────────────────────────────────────────────────
class VISCAZoom:
    """Reads zoom position from G21Z30S via RS-232 VISCA."""

    ZOOM_POS_QUERY = bytes([0x81, 0x09, 0x04, 0x47, 0xFF])

    def __init__(self, port=None, baud=9600):
        self.ser   = None
        self.zoom  = 1.0   # current zoom multiplier (1x … MAX_ZOOM)
        self._connect(port, baud)

    def _connect(self, port, baud):
        if port is None:
            # Auto-detect: look for first available serial port
            ports = serial.tools.list_ports.comports()
            port  = ports[0].device if ports else None
        if port is None:
            print("[VISCA] No serial port found — zoom scaling disabled")
            return
        try:
            self.ser = serial.Serial(port, baud, timeout=0.1)
            print(f"[VISCA] Connected on {port}")
        except Exception as e:
            print(f"[VISCA] Could not open {port}: {e} — zoom scaling disabled")

    def update(self):
        """Query camera for zoom position; update self.zoom."""
        if self.ser is None:
            return
        try:
            self.ser.write(self.ZOOM_POS_QUERY)
            time.sleep(0.02)
            resp = self.ser.read(7)           # VISCA reply is 7 bytes
            if len(resp) == 7 and resp[0] == 0x90:
                # Bytes 2-5 encode zoom position as 4 nibbles (0x0000–0x4000)
                p  = ((resp[2] & 0x0F) << 12 |
                      (resp[3] & 0x0F) <<  8 |
                      (resp[4] & 0x0F) <<  4 |
                      (resp[5] & 0x0F))
                # Map 0x0000…0x4000 → 1x…MAX_ZOOM
                self.zoom = 1.0 + (p / 0x4000) * (MAX_ZOOM - 1)
        except Exception:
            pass   # silently ignore transient serial errors

    def close(self):
        if self.ser:
            self.ser.close()


# ─────────────────────────────────────────────────────────────────────────────
# DEPTH MODEL  (Depth Anything V2)
# ─────────────────────────────────────────────────────────────────────────────
MODEL_CONFIGS = {
    "vits": {"encoder": "vits", "features": 64,  "out_channels": [48,  96,  192,  384]},
    "vitb": {"encoder": "vitb", "features": 128, "out_channels": [96,  192, 384,  768]},
    "vitl": {"encoder": "vitl", "features": 256, "out_channels": [256, 512, 1024, 1024]},
}

def load_depth_model(encoder, checkpoint):
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    print(f"[Depth] Loading Depth Anything V2 ({encoder}) on {device} ...")
    model = DepthAnythingV2(**MODEL_CONFIGS[encoder])
    model.load_state_dict(torch.load(checkpoint, map_location="cpu"))
    model = model.to(device).eval()
    print("[Depth] Model ready.")
    return model, device


# ─────────────────────────────────────────────────────────────────────────────
# HELPERS
# ─────────────────────────────────────────────────────────────────────────────
_COLORS = {}
def class_color(cls_id):
    if cls_id not in _COLORS:
        np.random.seed(cls_id + 42)
        _COLORS[cls_id] = tuple(int(c) for c in np.random.randint(80, 230, 3))
    return _COLORS[cls_id]

def depth_to_distance(rel_depth, K, zoom):
    """Convert normalised inverse depth to metres, zoom-corrected."""
    # MiDaS / DA relative depth ∝ 1/distance
    # Zoom multiplies apparent depth: at 2× zoom, same object looks 2× closer
    return (K * zoom) / (rel_depth + 1e-6)

def draw_label(img, text, x, y, color, font_scale=0.55, thickness=2):
    (tw, th), _ = cv2.getTextSize(text, cv2.FONT_HERSHEY_SIMPLEX, font_scale, thickness)
    cv2.rectangle(img, (x - 2, y - th - 6), (x + tw + 4, y + 2), color, -1)
    cv2.putText(img, text, (x, y - 2),
                cv2.FONT_HERSHEY_SIMPLEX, font_scale, (255, 255, 255), thickness)

def sample_depth(depth_norm, cx, cy, pad=12):
    roi = depth_norm[max(0, cy-pad):cy+pad, max(0, cx-pad):cx+pad]
    return float(np.median(roi)) if roi.size > 0 else 1e-6


# ─────────────────────────────────────────────────────────────────────────────
# MOUSE STATE  (click-to-measure)
# ─────────────────────────────────────────────────────────────────────────────
click_points = []    # list of (x, y, timestamp)
CLICK_TTL    = 4.0   # seconds a click label stays on screen

def on_mouse(event, x, y, flags, param):
    if event == cv2.EVENT_LBUTTONDOWN:
        click_points.append([x, y, time.time()])


# ─────────────────────────────────────────────────────────────────────────────
# MAIN
# ─────────────────────────────────────────────────────────────────────────────
def main():
    # ── Load models ───────────────────────────────────────────────────────
    yolo                = YOLO(YOLO_MODEL)
    depth_model, device = load_depth_model(DA_ENCODER, DA_CHECKPOINT)
    visca               = VISCAZoom(VISCA_PORT, VISCA_BAUD)

    # ── Camera ────────────────────────────────────────────────────────────
    cap = cv2.VideoCapture(CAMERA_INDEX)
    cap.set(cv2.CAP_PROP_FRAME_WIDTH,  CAMERA_W)
    cap.set(cv2.CAP_PROP_FRAME_HEIGHT, CAMERA_H)
    if not cap.isOpened():
        print(f"[ERROR] Cannot open camera index {CAMERA_INDEX}")
        sys.exit(1)

    # ── Window & mouse callback ────────────────────────────────────────────
    WIN = "G21Z30S | Distance Estimator"
    cv2.namedWindow(WIN, cv2.WINDOW_NORMAL)
    cv2.resizeWindow(WIN, 1280, 720)
    cv2.setMouseCallback(WIN, on_mouse)

    # ── Calibration state ─────────────────────────────────────────────────
    K              = 5.0
    calib_pending  = False
    depth_norm_cur = None    # latest depth map (shared between detection & click)

    print("\nControls:  Q = quit   C = calibrate K   Left-click = measure point\n")

    visca_tick = time.time()

    while True:
        ret, frame = cap.read()
        if not ret:
            print("[WARN] Frame grab failed — retrying...")
            time.sleep(0.05)
            continue

        h, w = frame.shape[:2]

        # ── Poll VISCA zoom every 0.5 s ───────────────────────────────────
        if time.time() - visca_tick > 0.5:
            visca.update()
            visca_tick = time.time()

        zoom = visca.zoom   # current zoom level (1.0 if no serial connection)

        # ── Depth map ─────────────────────────────────────────────────────
        with torch.no_grad():
            depth_raw = depth_model.infer_image(frame)   # HxW numpy float32

        depth_norm_cur = cv2.normalize(depth_raw, None, 0, 1, cv2.NORM_MINMAX)

        # ── YOLO detection ────────────────────────────────────────────────
        results = yolo(frame, verbose=False)[0]

        for box in results.boxes:
            x1, y1, x2, y2 = map(int, box.xyxy[0])
            cls_id   = int(box.cls[0])
            cls_name = results.names[cls_id]
            conf     = float(box.conf[0])
            color    = class_color(cls_id)

            cx, cy   = (x1 + x2) // 2, (y1 + y2) // 2
            rel      = sample_depth(depth_norm_cur, cx, cy)
            dist_m   = depth_to_distance(rel, K, zoom)

            # ── Calibrate on next frame if pending ────────────────────────
            if calib_pending:
                K = CALIB_DIST_M / (rel * zoom + 1e-6)
                print(f"[CALIB] K = {K:.4f}  (object '{cls_name}' at {CALIB_DIST_M} m, zoom {zoom:.1f}×)")
                calib_pending = False

            # ── Draw box + label ──────────────────────────────────────────
            cv2.rectangle(frame, (x1, y1), (x2, y2), color, 2)
            cv2.drawMarker(frame, (cx, cy), color, cv2.MARKER_CROSS, 14, 2)
            label = f"{cls_name}  {dist_m:.2f} m  ({conf:.0%})"
            draw_label(frame, label, x1, y1, color)

        # ── Click-to-measure ──────────────────────────────────────────────
        now = time.time()
        # Expire old clicks
        click_points[:] = [p for p in click_points if now - p[2] < CLICK_TTL]

        for pt in click_points:
            px, py, _ = pt
            if depth_norm_cur is not None:
                rel    = sample_depth(depth_norm_cur, px, py, pad=6)
                dist_m = depth_to_distance(rel, K, zoom)
                # Draw crosshair + distance pin
                cv2.drawMarker(frame, (px, py), (0, 220, 255),
                               cv2.MARKER_TILTED_CROSS, 18, 2)
                draw_label(frame, f"  {dist_m:.2f} m  ",
                           px + 14, py, (20, 130, 180), font_scale=0.6)

        # ── Depth map thumbnail (top-right) ───────────────────────────────
        depth_vis = cv2.applyColorMap(
            (depth_norm_cur * 255).astype(np.uint8), cv2.COLORMAP_INFERNO)
        th, tw = h // 4, w // 4
        thumb  = cv2.resize(depth_vis, (tw, th))
        frame[10:10+th, w-tw-10:w-10] = thumb
        cv2.rectangle(frame, (w-tw-10, 10), (w-10, 10+th), (80,80,80), 1)
        cv2.putText(frame, "depth map", (w-tw-6, 10+th+14),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.42, (180,180,180), 1)

        # ── HUD bar ───────────────────────────────────────────────────────
        hud = (f"K={K:.3f}  |  zoom={zoom:.1f}x  |  "
               f"{'VISCA OK' if visca.ser else 'no VISCA'}  |  "
               f"Q=quit  C=calibrate  click=measure")
        cv2.rectangle(frame, (0, h-28), (w, h), (0,0,0), -1)
        cv2.putText(frame, hud, (8, h-8),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.46, (200,200,200), 1)

        cv2.imshow(WIN, frame)

        key = cv2.waitKey(1) & 0xFF
        if key == ord('q'):
            break
        elif key == ord('c'):
            calib_pending = True
            print(f"[CALIB] Waiting — point at object {CALIB_DIST_M} m away ...")

    cap.release()
    visca.close()
    cv2.destroyAllWindows()


if __name__ == "__main__":
    main()
How each feature works
Depth Anything V2 Uses model.infer_image(frame) directly — no manual transform pipeline needed. The vitb checkpoint is the best everyday choice. Swap DA_ENCODER = "vitl" for maximum accuracy if you have a GPU.

VISCA zoom integration Every 0.5 seconds the script sends a VISCA CAM_ZoomPosInq command over serial and reads back the 4-nibble zoom position. It maps the raw value 0x0000–0x4000 to 1×–30×. The distance formula then becomes (K × zoom) / rel_depth — so as you zoom in, the estimated distance stays correct automatically. If no serial port is found it falls back gracefully to zoom = 1.0.

Click to measure A mouse callback stores every left-click with a timestamp. Each frame, live distances are computed at those coordinates from the current depth map and drawn as floating pin labels. Clicks fade after 4 seconds.

